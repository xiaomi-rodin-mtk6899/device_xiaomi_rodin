type parts_app, domain;
typeattribute parts_app mlstrustedsubject;

app_domain(parts_app)

allow parts_app activity_service:service_manager find;
allow parts_app activity_task_service:service_manager find;
allow parts_app audio_service:service_manager find;
allow parts_app netstats_service:service_manager find;
allow parts_app vendor_hal_displayfeature_service:service_manager find;
allow parts_app hal_touchfeature_xiaomi_service:service_manager find;
allow parts_app batterystats_service:service_manager find;
allow parts_app gpu_service:service_manager find;
allow parts_app voiceinteraction_service:service_manager find;
allow parts_app autofill_service:service_manager find;
allow parts_app sensitive_content_protection_service:service_manager find;
allow parts_app uimode_service:service_manager find;
allow parts_app clipboard_service:service_manager find;
allow parts_app batteryproperties_service:service_manager find;
allow parts_app telecom_service:service_manager find;
allow parts_app vibrator_manager_service:service_manager find;
allow parts_app thermal_service:service_manager find;
allow parts_app sysfs_therm:dir search;
allow parts_app legacy_permission_service:service_manager find;

binder_call(parts_app, vendor_hal_displayfeature_default)
binder_call(parts_app, hal_touchfeature_xiaomi_default)

allow parts_app system_app_data_file:dir create_dir_perms;
allow parts_app system_app_data_file:file create_file_perms;
allow parts_app system_app_data_file:lnk_file create_file_perms;
allow parts_app sysfs_therm:file rw_file_perms;

allow parts_app app_function_service:service_manager find;

# ── System monitor (battery / CPU / GPU / thermal) ──────────────────────
# Read-only access to the sysfs and proc nodes used by the System Monitor
# section: CPU cpufreq policies, power-supply (battery) info, DVFSRC,
# generic sysfs, /proc/stat|meminfo|cpuinfo|loadavg|uptime|version,
# per-UID CPU accounting, per-pid proc entries, MTK GPU freq/load nodes.

# /sys/devices/system/cpu (cpufreq policies, core online status)
allow parts_app sysfs_devices_system_cpu:dir r_dir_perms;
allow parts_app sysfs_devices_system_cpu:file r_file_perms;

# /sys/devices/platform/*/power_supply (battery raw attributes)
allow parts_app sysfs_batteryinfo:dir r_dir_perms;
allow parts_app sysfs_batteryinfo:file r_file_perms;

# MTK DVFSRC devfreq (current CPU/GPU bus frequency)
allow parts_app sysfs_dvfsrc_devfreq:dir r_dir_perms;
allow parts_app sysfs_dvfsrc_devfreq:file r_file_perms;

# Generic sysfs (fallback battery/thermal nodes)
allow parts_app sysfs:dir r_dir_perms;
allow parts_app sysfs:file r_file_perms;

# /proc generic (per-pid stat/statm/cmdline)
allow parts_app proc:dir r_dir_perms;
allow parts_app proc:file r_file_perms;

# Whitelisted proc nodes
allow parts_app proc_stat:file r_file_perms;
allow parts_app proc_meminfo:file r_file_perms;
allow parts_app proc_cpuinfo:file r_file_perms;
allow parts_app proc_loadavg:file r_file_perms;
allow parts_app proc_uptime:file r_file_perms;
allow parts_app proc_version:file r_file_perms;
allow parts_app proc_uid_cputime_showstat:file r_file_perms;

# MTK GPU accounting (/proc/gpufreqv2, /proc/ged/hal/gpu_utilization)
allow parts_app proc_gpufreqv2:file r_file_perms;
allow parts_app proc_ged:dir r_dir_perms;
allow parts_app proc_ged:file r_file_perms;

# ── Swap (zRAM) size control ────────────────────────────────────────────
# persist.sys.zram_size_percent drives the init-triggered zram resize
# helper (see vendor_init.te / init.zram_resize.rc).
set_prop(parts_app, system_prop)
get_prop(parts_app, system_prop)

# Current zram state (/sys/block/zram0/disksize)
allow parts_app sysfs_zram:dir r_dir_perms;
allow parts_app sysfs_zram:file r_file_perms;

# Swap usage (/proc/swaps)
allow parts_app proc_swaps:file r_file_perms;

