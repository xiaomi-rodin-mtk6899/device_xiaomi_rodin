type misys_core, domain;
type misys_core_exec, exec_type, vendor_file_type, file_type;

permissive misys_core;

init_daemon_domain(misys_core)

allow servicemanager misys_core:binder call;
allow misys_core servicemanager:binder call;

allow misys_core misys_core_service:service_manager add;
allow misys_core block_device:dir search;
allow misys_core block_device:blk_file setattr;
allow misys_core servicemanager:binder transfer;
