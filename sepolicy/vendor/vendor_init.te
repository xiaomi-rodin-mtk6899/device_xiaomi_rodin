# Rodin-specific vendor_init rules (restored from compiled policy).

# Property setup for the vendor daemons shipped on this device.
set_prop(vendor_init, vendor_audio_cit_prop)
set_prop(vendor_init, vendor_batteryantiaging_prop)
set_prop(vendor_init, vendor_batterysecret_prop)
set_prop(vendor_init, vendor_displayfeature_prop)
set_prop(vendor_init, vendor_fingerprint_prop)
set_prop(vendor_init, vendor_touchfeature_prop)
set_prop(vendor_init, exported_system_prop)
set_prop(vendor_init, vendor_us_proximity_prop)

# MiTEE dump directory and devices.
allow vendor_init minidump_data_file:dir create_dir_perms;
allow vendor_init minidump_data_file:file create_file_perms;
allow vendor_init miev_dev:chr_file getattr;
allow vendor_init migt_dev:chr_file getattr;

# ──────────────────────────────────────────────────────────────────────────
# Dynamic zram (swap) size — Xiaomi Parts.
# The resize helper runs in the dedicated zram_resize domain (see
# zram_resize.te / init.zram_resize.rc); vendor_init itself needs no
# additional permissions here.
