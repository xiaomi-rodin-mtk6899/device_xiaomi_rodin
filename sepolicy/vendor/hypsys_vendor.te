type hypsys_vendor, domain;
type hypsys_vendor_exec, exec_type, vendor_file_type, file_type;

permissive hypsys_vendor;

init_daemon_domain(hypsys_vendor)

allow hypsys_vendor vendor_camera_data_file:file { write open };
allow hypsys_vendor procfs_memory:file r_file_perms;
allow hypsys_vendor vendor_proc_tp_file:file r_file_perms;
allow hypsys_vendor vendor_proc_tp_lockdown:file r_file_perms;
allow hypsys_vendor sysfs_soc:dir search;
allow hypsys_vendor vendor_sysfs_displayfeature:file r_file_perms;
