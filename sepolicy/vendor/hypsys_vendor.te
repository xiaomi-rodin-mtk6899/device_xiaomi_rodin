type hypsys_vendor, domain;
type hypsys_vendor_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hypsys_vendor)

get_prop(hypsys_vendor, vendor_fingerprint_prop)

allow hypsys_vendor vendor_camera_data_file:file { read write open };
allow hypsys_vendor procfs_memory:file r_file_perms;
allow hypsys_vendor vendor_proc_tp_file:file r_file_perms;
allow hypsys_vendor vendor_proc_tp_lockdown:file r_file_perms;
allow hypsys_vendor sysfs_soc:dir search;
allow hypsys_vendor vendor_sysfs_displayfeature:file r_file_perms;
allow hypsys_vendor sysfs:file rw_file_perms;
allow hypsys_vendor sysfs_soc:file r_file_perms;
allow hypsys_vendor block_device:dir search;
allow hypsys_vendor block_device:blk_file { read open write getattr };
allow hypsys_vendor { servicemanager misys_core hypsys_vendor }:binder { transfer call };
allow hypsys_vendor vendor_sysfs_displayfeature:dir search;
allow hypsys_vendor misys_core_service:service_manager find;
allow hypsys_vendor vendor_camera_data_file:dir search;

# miui cam
allow hypsys_vendor vendor_camera_data_file:dir { create rw_dir_perms };
allow hypsys_vendor vendor_camera_data_file:file create_file_perms;
allow hypsys_vendor appdomain_tmpfs:file rw_file_perms;
typeattribute hypsys_vendor mlstrustedsubject;
allow hypsys_vendor vendor_data_file:dir search;
binder_call(hypsys_vendor, miuicamera_app)
binder_call(hypsys_vendor, mtk_hal_camera)
binder_use(hypsys_vendor)
allow hypsys_vendor hal_misys_vendor_service_custom:service_manager add;
allow hypsys_vendor misys_blackbox_service:service_manager add;
allow hypsys_vendor kmsg_device:chr_file rw_file_perms;
